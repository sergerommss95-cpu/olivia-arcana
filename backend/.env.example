# Olivia Arcana backend — environment variables.
# Copy to .env (or set in Railway) and fill in real values. NO real values here.

# ── Core ──
# "production" makes a missing JWT_SECRET a startup error. Railway also sets
# RAILWAY_ENVIRONMENT automatically, which counts as production.
ENV=development
# Secret for signing our own HS256 access tokens. REQUIRED in production.
JWT_SECRET=

# ── Supabase auth ──
# Project JWT secret (Supabase dashboard → Settings → API → JWT Secret).
# Used to verify Supabase access tokens sent as Bearer by the frontend.
SUPABASE_JWT_SECRET=

# ── Database ──
# Postgres URL on Railway (postgres:// is auto-rewritten to asyncpg).
# Unset = local SQLite at ./data/olivia.db.
DATABASE_URL=

# ── Anthropic (api/ask.py oracle endpoint) ──
ANTHROPIC_API_KEY=

# ── Paddle (Merchant of Record — web payments) ──
# "sandbox" or "production" (default sandbox).
PADDLE_ENV=sandbox
# Server-side API key (Paddle vendor dashboard).
PADDLE_API_KEY=
# Secret for verifying webhook HMAC signatures.
PADDLE_WEBHOOK_SECRET=
# Subscription price IDs (one per tier x period).
PADDLE_PRICE_INSIGHT_MONTHLY=
PADDLE_PRICE_INSIGHT_ANNUAL=
PADDLE_PRICE_PREMIUM_MONTHLY=
PADDLE_PRICE_PREMIUM_ANNUAL=
PADDLE_PRICE_VIP_MONTHLY=
PADDLE_PRICE_VIP_ANNUAL=
# One-time addon price IDs.
PADDLE_PRICE_ADDON_BIRTH_CHART=
PADDLE_PRICE_ADDON_COMPATIBILITY=
PADDLE_PRICE_ADDON_CELTIC_CROSS=
PADDLE_PRICE_ADDON_YEAR_AHEAD=
PADDLE_PRICE_ADDON_SOLAR_RETURN=
PADDLE_PRICE_ADDON_VIDEO_READING=

# ── Telegram Stars (in-bot payments) ──
# Primary bot token used for sendInvoice / refunds.
TELEGRAM_BOT_TOKEN_EN=

# NOTE: services/stripe_service.py still exists but is dead code (never
# imported; Stripe is banned for this business). Its STRIPE_* / SITE_URL env
# vars are NOT read by the running app and are intentionally omitted here.
