+.page { --paper: #eee9df; --ink: #20243c; --muted: #65636c; --line: #c6c0b6; min-height: 100svh; padding: 0 clamp(1.2rem, 5vw, 5.5rem) 2rem; color: var(--ink); background: var(--paper); font-family: var(--font-body), sans-serif; }
